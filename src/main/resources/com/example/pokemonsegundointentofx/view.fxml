<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pokemonsegundointentofx.Controller.MainController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Centro Pokémon - Registro Simplificado" />

    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" promptText="Ej: Pikachu" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Nivel (1-100):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNivel" promptText="Ej: 25" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cmbTipo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <Button onAction="#handleRegistrar" text="Registrar Pokémon" />

    <TableView fx:id="tblPokemones" prefHeight="200.0" prefWidth="450.0">
        <columns>
            <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
            <TableColumn fx:id="colNivel" prefWidth="80.0" text="Nivel" />
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
            <TableColumn fx:id="colCosto" prefWidth="130.0" text="Costo Curación" />
        </columns>
    </TableView>
    <Button onAction="#handleEliminar" text="Dar de Alta (Eliminar seleccionado)" />

</VBox>







